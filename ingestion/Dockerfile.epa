FROM python:3.15-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
COPY ingestion/requirements-epa.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt \
    && useradd --uid 10001 --create-home worker
COPY ingestion/db.py ingestion/epa_manifest.py ingestion/epa_state.py ingestion/epa_download.py /app/ingestion/
COPY config/settings.yaml /app/config/settings.yaml
COPY output/epa/manifest.csv /app/output/epa/manifest.csv
RUN chmod -R a+rX /app
USER worker
ENTRYPOINT ["python", "-m", "ingestion.epa_download"]
