FROM python:3.15-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
COPY ingestion/requirements-airnow.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt \
    && useradd --uid 10001 --create-home worker
COPY ingestion/db.py ingestion/airnow_collect.py /app/ingestion/
COPY config/settings.yaml /app/config/settings.yaml
RUN chmod -R a+rX /app
USER worker
ENTRYPOINT ["python", "-m", "ingestion.airnow_collect"]
